{
  "info": {
    "name": "STPS Lab 1 Microservices (Variant 8)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Inventory Health (8008)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8008/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Inventory service ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Order Health (9008)",
      "request": {
        "method": "GET",
        "url": "http://localhost:9008/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Order service ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Order and Reserve Stock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"item_id\": 1, \"quantity\": 5}"
        },
        "url": "http://localhost:9008/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Order confirmed\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql(\"confirmed\");",
              "  pm.expect(body.remaining_stock).to.be.a(\"number\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject Insufficient Stock (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"item_id\": 3, \"quantity\": 999}"
        },
        "url": "http://localhost:9008/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}